generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. User Model (Handles both Admins and Students)
model User {
  id           String     @id @default(uuid())
  role         Role       @default(STUDENT)
  hallTicket   String?    @unique // Only students will have this
  passwordHash String
  feedbacks    Feedback[] 
  createdAt    DateTime   @default(now())
}

enum Role {
  STUDENT
  ADMIN
}

// 2. Lecturer Model
model Lecturer {
  id         String     @id @default(uuid())
  name       String
  department String
  feedbacks  Feedback[]
}

// 3. Class/Course Model
model Class {
  id          String     @id @default(uuid())
  name        String     // e.g., "Computer Science Year 3"
  feedbacks   Feedback[]
}

// 4. Feedback Model (Connects Student, Lecturer, and Class)
model Feedback {
  id          String   @id @default(uuid())
  rating      Int      // 1 to 5 stars
  comments    String?  // Optional text feedback
  createdAt   DateTime @default(now())

  // Relations
  studentId   String
  student     User     @relation(fields: [studentId], references: [id])
  
  lecturerId  String
  lecturer    Lecturer @relation(fields: [lecturerId], references: [id])

  classId     String
  classObj    Class    @relation(fields: [classId], references: [id])
}